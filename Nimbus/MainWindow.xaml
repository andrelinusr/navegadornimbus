<Window x:Class="Nimbus.MainWindow"
        Icon="Assets\POV_1_.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Navegador Nimbus"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        Background="#0F1115"
        Closed="Window_Closed">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#050506"/>
        <SolidColorBrush x:Key="TopBarBrush" Color="#0B0B0D"/>
        <SolidColorBrush x:Key="TabBgBrush" Color="#111216"/>
        <SolidColorBrush x:Key="TabHoverBrush" Color="#1A1B20"/>
        <SolidColorBrush x:Key="TabSelectedBrush" Color="#14151A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F5F8"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B7C0CC"/>
        <SolidColorBrush x:Key="UrlBgBrush" Color="#1C1B22"/>
        <SolidColorBrush x:Key="UrlBorderBrush" Color="#3A3940"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#22232A"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#2C2D35"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="17"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#202127"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#2C2D35"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource UrlBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UrlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="UrlBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="UrlBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="UrlBorder" Property="Background" Value="#23222B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="MaxWidth" Value="230"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource TabBgBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid x:Name="Root" Margin="1,4,1,0" SnapsToDevicePixels="True">
                            <Border x:Name="TabChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="9,9,0,0">
                                <ContentPresenter x:Name="ContentSite"
                                                  ContentSource="Header"
                                                  Margin="8,0,6,0"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource TabHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="10"/>
                                <Setter Property="Background" Value="{StaticResource TabSelectedBrush}"/>
                                <Setter Property="BorderBrush" Value="#454D59"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource ChromeTabItemStyle}"/>

        <Style x:Key="NewTabButtonStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid Margin="4,4,0,0" Width="34" Height="34">
                            <Border x:Name="AddChrome"
                                    Background="Transparent"
                                    CornerRadius="17">
                                <TextBlock Text="+"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-2,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AddChrome" Property="Background" Value="#202127"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="AddChrome" Property="Background" Value="#2C2D35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{StaticResource WindowBgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="52"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource TopBarBrush}">
                                <TabPanel IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"
                                          Panel.ZIndex="1"
                                          Margin="8,0,8,0"/>
                            </Border>

                            <Border Grid.Row="1"
                                    Background="{StaticResource TabSelectedBrush}"
                                    BorderBrush="#090A0C"
                                    BorderThickness="0,1,0,1">
                                <Grid Margin="8,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Style="{StaticResource NavButtonStyle}"
                                            Content="&#xE72B;"
                                            ToolTip="Voltar"
                                            Click="BackButton_Click"
                                            Grid.Column="0"/>
                                    <Button Style="{StaticResource NavButtonStyle}"
                                            Content="&#xE72A;"
                                            ToolTip="Avancar"
                                            Click="ForwardButton_Click"
                                            Grid.Column="1"/>
                                    <Button Style="{StaticResource NavButtonStyle}"
                                            Content="&#xE72C;"
                                            ToolTip="Recarregar"
                                            Click="ReloadButton_Click"
                                            Grid.Column="2"/>
                                    <Button Style="{StaticResource NavButtonStyle}"
                                            Content="&#xE80F;"
                                            ToolTip="Inicio"
                                            Click="HomeButton_Click"
                                            Grid.Column="3"/>

                                    <TextBox x:Name="UrlTextBox"
                                             KeyDown="UrlTextBox_KeyDown"
                                             Grid.Column="4"
                                             Margin="8,0"
                                             HorizontalAlignment="Stretch"/>

                                    <Button Style="{StaticResource NavButtonStyle}"
                                            Content="&#xE721;"
                                            ToolTip="Ir"
                                            Click="GoButton_Click"
                                            Grid.Column="5"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Background="{StaticResource WindowBgBrush}">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBgBrush}">
        <TabControl Name="tabControl"
                    Style="{StaticResource CustomTabControlStyle}"
                    SelectionChanged="TabControl_SelectionChanged">
            <TabItem Name="InitialTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="16" Height="16" Margin="0,0,7,0"/>
                        <TextBlock Text="Nova aba"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="12"
                                   Width="120"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Content="X"
                                Width="20"
                                Height="20"
                                Margin="7,0,0,0"
                                FontSize="11"
                                Click="CloseTabButton_Click"/>
                    </StackPanel>
                </TabItem.Header>
                <wv2:WebView2 x:Name="browser"
                              Source="https://nimbus-navegadorpaginainicial-4bcada32.base44.app/"
                              NavigationCompleted="Browser_NavigationCompleted"/>
            </TabItem>

            <TabItem Header="+"
                     Name="NewTabItem"
                     Style="{StaticResource NewTabButtonStyle}"/>
        </TabControl>
    </Grid>
</Window>
